// supabase/functions/paystack-verify/index.ts
// Verifies a Paystack transaction after the user returns from checkout

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";

const PAYSTACK_SECRET_KEY = Deno.env.get("PAYSTACK_SECRET_KEY")!;

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
};

serve(async (req) => {
  if (req.method === "OPTIONS") {
    return new Response("ok", { headers: corsHeaders });
  }

  if (req.method !== "POST") {
    return new Response(
      JSON.stringify({ error: "Method not allowed" }),
      { status: 405, headers: { ...corsHeaders, "Content-Type": "application/json" } }
    );
  }

  try {
    const { reference } = await req.json();

    if (!reference) {
      return new Response(
        JSON.stringify({ error: "Missing reference" }),
        { status: 400, headers: { ...corsHeaders, "Content-Type": "application/json" } }
      );
    }

    console.log("🔍 Verifying Paystack transaction:", reference);

    // Call Paystack Verify Transaction API
    const response = await fetch(
      `https://api.paystack.co/transaction/verify/${encodeURIComponent(reference)}`,
      {
        method: "GET",
        headers: {
          Authorization: `Bearer ${PAYSTACK_SECRET_KEY}`,
        },
      }
    );

    const data = await response.json();

    if (!data.status) {
      console.error("Paystack verify API failed:", data);
      return new Response(
        JSON.stringify({
          verified: false,
          status: "failed",
          message: data.message || "Verification failed",
        }),
        { headers: { ...corsHeaders, "Content-Type": "application/json" } }
      );
    }

    const tx = data.data;

    // Check transaction status
    if (tx.status !== "success") {
      console.warn("Transaction not successful:", tx.status);
      return new Response(
        JSON.stringify({
          verified: false,
          status: tx.status,
          message: `Transaction status: ${tx.status}`,
        }),
        { headers: { ...corsHeaders, "Content-Type": "application/json" } }
      );
    }

    console.log("✅ Transaction verified:", tx.reference, tx.amount);

    return new Response(
      JSON.stringify({
        verified: true,
        status: "success",
        amount: tx.amount,
        currency: tx.currency,
        reference: tx.reference,
        paid_at: tx.paid_at,
        channel: tx.channel,
        customer_email: tx.customer?.email,
        metadata: tx.metadata,
      }),
      { headers: { ...corsHeaders, "Content-Type": "application/json" } }
    );

  } catch (error) {
    console.error("Verify error:", error);
    return new Response(
      JSON.stringify({ verified: false, error: error.message || "Internal server error" }),
      { status: 500, headers: { ...corsHeaders, "Content-Type": "application/json" } }
    );
  }
});
